# -----------------------------------------------------------------------------
# Clothing application: existing local database and retrieval/cart APIs
# -----------------------------------------------------------------------------
CLOTHING_APP_APP_NAME=Clothing Demo Application
CLOTHING_APP_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/ClothingAppDummyDB
CLOTHING_APP_DATABASE_POOL_SIZE=5
CLOTHING_APP_DATABASE_MAX_OVERFLOW=5
CLOTHING_APP_CART_TTL_HOURS=24
CLOTHING_APP_PRODUCT_IMAGES_DIR=local/product_images
CLOTHING_APP_FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Clothing agent: routing, LLM, and clothing-application API connection
# -----------------------------------------------------------------------------
CLOTHING_AGENT_APP_NAME=Clothing AI Sales Agent
CLOTHING_AGENT_CLOTHING_APP_BASE_URL=http://127.0.0.1:8100
CLOTHING_AGENT_CLOTHING_APP_TIMEOUT_SECONDS=12
CLOTHING_AGENT_FRONTEND_ORIGIN=http://localhost:5173

CLOTHING_AGENT_LLM_API_BASE=https://api.groq.com/openai/v1
CLOTHING_AGENT_LLM_API_KEY=
CLOTHING_AGENT_LLM_MODEL=llama-3.3-70b-versatile
CLOTHING_AGENT_LLM_TIMEOUT_SECONDS=45
CLOTHING_AGENT_LLM_TEMPERATURE=0.2
CLOTHING_AGENT_LLM_MAX_TOKENS=500
CLOTHING_AGENT_DISPLAYED_PRODUCT_LIMIT=3
CLOTHING_AGENT_MAXIMUM_CLARIFICATION_QUESTIONS=2

# Keep true during local setup. Product search and simple conversation remain
# usable with deterministic fallbacks when the LLM key is absent or unavailable.
CLOTHING_AGENT_ALLOW_LOCAL_FALLBACK=true

# -----------------------------------------------------------------------------
# Frontend: shared URLs loaded from this same workspace-level environment file
# -----------------------------------------------------------------------------
VITE_APP_NAME=Atelier AI
VITE_AGENT_API_URL=http://127.0.0.1:8000
VITE_CLOTHING_APP_URL=http://127.0.0.1:8100

# Rotating operational and sales-flow audit logs
CLOTHING_AGENT_LOG_DIR=logs
CLOTHING_AGENT_LOG_MAX_BYTES=5000000
CLOTHING_AGENT_LOG_BACKUP_COUNT=5
CLOTHING_APP_LOG_DIR=logs
CLOTHING_APP_LOG_MAX_BYTES=5000000
CLOTHING_APP_LOG_BACKUP_COUNT=5
