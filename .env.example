# Public application
APP_PORT=7073
PUBLIC_ORIGIN=http://localhost:7073

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pgadmin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ClothingAppDummyDB
CLOTHING_APP_DATABASE_URL=postgresql+asyncpg://postgres:pgadmin@127.0.0.1:5432/ClothingAppDummyDB

# Groq LLM API Key
GROQ_API_KEY=gsk_your_key
CLOTHING_AGENT_LLM_API_BASE=https://api.groq.com/openai/v1
CLOTHING_AGENT_LLM_MODEL=llama-3.3-70b-versatile
CLOTHING_AGENT_ALLOW_LOCAL_FALLBACK=true

# Optional tuning
CLOTHING_AGENT_DISPLAYED_PRODUCT_LIMIT=3
CLOTHING_AGENT_MAXIMUM_CLARIFICATION_QUESTIONS=2
CLOTHING_APP_DATABASE_POOL_SIZE=5
CLOTHING_APP_DATABASE_MAX_OVERFLOW=5
